{
  "name": "template-next-js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "lint:debug": "eslint . --fix --debug",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "researcher:lint": "eslint app/researcher tests/researcher playwright.researcher.config.ts scripts/researcher-build.mjs scripts/researcher-preview.mjs scripts/researcher-workspace.mjs --max-warnings=0 && prettier --check .github/workflows/researcher-ci.yml",
    "researcher:unit": "jest app/researcher app/utils/studies",
    "researcher:test": "playwright test --config=playwright.researcher.config.ts",
    "researcher:preview": "node scripts/researcher-preview.mjs",
    "researcher:build": "node scripts/researcher-build.mjs",
    "researcher:ci": "npm run researcher:lint && npm run researcher:unit && npm run researcher:test && npm run researcher:build",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
