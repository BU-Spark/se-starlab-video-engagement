# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Cloud values: Supabase dashboard -> Project Settings -> API Keys
# Local values: printed by `npx supabase start` (or `npx supabase status`)

# Safe to expose to the browser. Used by both the researcher pages and the tablet app.
# Leave empty to run the tablet on mock data and the researcher pages as a preview (saving disabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Storage bucket for videos and button icons (default study-media).
# NEXT_PUBLIC_SUPABASE_STUDY_BUCKET=study-media

# Optional: PIN for the tablet's hidden researcher exit (default 0000).
# NEXT_PUBLIC_RESEARCHER_PIN=

# Server only. Bypasses Row Level Security - never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Optional: only needed for a direct Postgres connection (ORM, psql).
# Dashboard -> Connect. Contains the database password.
# DATABASE_URL=

# URL of the Python backend (docker compose up -d). Not used by the apps yet: both talk to Supabase directly.
NEXT_PUBLIC_API_URL=http://localhost:8000
