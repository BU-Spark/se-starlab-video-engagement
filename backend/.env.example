# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Local Supabase, as seen from inside the backend container.
# For the cloud project use https://<project-ref>.supabase.co instead.
SUPABASE_URL=http://host.docker.internal:54321

# Server only. Bypasses Row Level Security.
# Local: printed by `npx supabase start`. Cloud: dashboard -> Project Settings -> API Keys.
SUPABASE_SECRET_KEY=

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000
